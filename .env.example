# Copy this file to `.env` at your workspace root and fill in the values.
# None of this is committed (see .gitignore).

# ——— Meta Graph API ————————————————————————————————————————————————
# Long-lived token with ads_read scope. Generate from:
# https://developers.facebook.com/tools/explorer/ → "Get Token" → select ads_read
FB_ACCESS_TOKEN=

# ——— Google Ads API ———————————————————————————————————————————————
# Developer token: apply at https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth client (type: Desktop app) from Google Cloud Console
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token — generate once via the Google Ads API OAuth flow.
# See: https://developers.google.com/google-ads/api/docs/oauth/cloud-project
GOOGLE_ADS_REFRESH_TOKEN=

# Your MCC manager customer ID (dashes OK or stripped: 241-140-5250 or 2411405250)
GOOGLE_ADS_MANAGER_ID=

# ——— Vercel ——————————————————————————————————————————————————————
# Optional. If unset, scripts use the `vercel login` OAuth session.
# For headless / cron runs, create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
